MAIN
{
	INTEGER guess = 0 ;

	INTEGER number = INPUT ;

	WHILE guess != number ;
	{
		IF guess < number THEN ;
		{
			OUPTPUT "Too low! Try again.\n" ;
		}
		IF guess > number THEN;
		{
			OUPTPUT "Too high! Try again.\n" ;
		}
		number = INPUT ;
	}
	OUPTPUT "Congratulations! You guessed the number!\n" ;
}